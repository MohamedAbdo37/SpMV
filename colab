      "source": [
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "import numpy as np\n",
        "\n",
        "# 1. Load the Data\n",
        "# Upload your 'experiment_results.csv' to Colab first!\n",
        "try:\n",
        "    df = pd.read_csv('experiment_results.csv')\n",
        "    print(\"Data loaded successfully!\")\n",
        "except FileNotFoundError:\n",
        "    print(\"Error: Please upload 'experiment_results.csv' to the Colab file area.\")\n",
        "    # Create dummy data if file is missing (for demonstration)\n",
        "    data = {\n",
        "        'Rows': [1000, 5000, 10000, 20000, 30000],\n",
        "        'Density': [0.02]*5,\n",
        "        'Time_ms': [0.1, 15.5, 60.2, 250.5, 600.0],\n",
        "        'ExecutionType': ['Serial']*5\n",
        "    }\n",
        "    # ... (skipping dummy generation for brevity, assume user uploads file)\n",
        "\n",
        "# 2. Data Preprocessing\n",
        "# Pivot the table to get Serial and Parallel times side-by-side\n",
        "df_pivot = df.pivot_table(index=['Rows', 'Density'],\n",
        "                          columns='ExecutionType',\n",
        "                          values='Time_ms').reset_index()\n",
        "\n",
        "# Calculate Speedup (Serial / Parallel)\n",
        "df_pivot['Speedup'] = df_pivot['Serial'] / df_pivot['Parallel']\n",
        "\n",
        "# Calculate Memory in MB for plotting (Use the first occurrence per size)\n",
        "mem_df = df.groupby('Rows')[['Dense_KB', 'CSR_KB']].max().reset_index()\n",
        "mem_df['Dense_MB'] = mem_df['Dense_KB'] / 1024\n",
        "mem_df['CSR_MB'] = mem_df['CSR_KB'] / 1024\n",
        "\n",
        "# Set standard plot style\n",
        "sns.set_theme(style=\"whitegrid\")\n",
        "plt.rcParams.update({'font.size': 12})\n",
        "\n",
        "# ==========================================\n",
        "# PLOT 1: Performance Comparison (Time vs Size)\n",
        "# ==========================================\n",
        "def plot_execution_time(target_density=0.02):\n",
        "    subset = df[df['Density'] == target_density]\n",
        "\n",
        "    plt.figure(figsize=(10, 6))\n",
        "\n",
        "    # Plot Serial\n",
        "    sns.lineplot(data=subset[subset['ExecutionType']=='Serial'],\n",
        "                 x='Rows', y='Time_ms', marker='o', label='Serial', linewidth=2, color='red')\n",
        "\n",
        "    # Plot Parallel\n",
        "    sns.lineplot(data=subset[subset['ExecutionType']=='Parallel'],\n",
        "                 x='Rows', y='Time_ms', marker='o', label='Parallel (OpenMP)', linewidth=2, color='blue')\n",
        "\n",
        "    plt.title(f'Execution Time vs Matrix Size (Density={target_density})', fontsize=14, fontweight='bold')\n",
        "    plt.xlabel('Matrix Dimension (N)', fontsize=12)\n",
        "    plt.ylabel('Time (milliseconds)', fontsize=12)\n",
        "    plt.legend()\n",
        "    plt.grid(True, which=\"both\", ls=\"-\", alpha=0.5)\n",
        "\n",
        "    # Optional: Save figure\n",
        "    plt.savefig(f\"time_comparison_d{target_density}.png\", dpi=300)\n",
        "    plt.show()\n",
        "\n",
        "# ==========================================\n",
        "# PLOT 2: Speedup Analysis (Scalability)\n",
        "# ==========================================\n",
        "def plot_speedup():\n",
        "    plt.figure(figsize=(10, 6))\n",
        "\n",
        "    # Iterate through a few key densities to show trends\n",
        "    densities_to_plot = df['Density'].unique()\n",
        "\n",
        "    # Use a color palette\n",
        "    palette = sns.color_palette(\"viridis\", len(densities_to_plot))\n",
        "\n",
        "    for i, dens in enumerate(densities_to_plot):\n",
        "        subset = df_pivot[df_pivot['Density'] == dens]\n",
        "        plt.plot(subset['Rows'], subset['Speedup'], marker='s', label=f'Density {dens}', color=palette[i])\n",
        "\n",
        "    # Add a \"Break-even\" line at y=1\n",
        "    plt.axhline(y=1, color='k', linestyle='--', label='Serial Baseline (1x)')\n",
        "\n",
        "    plt.title('Speedup Factor vs Problem Size', fontsize=14, fontweight='bold')\n",
        "    plt.xlabel('Matrix Dimension (N)', fontsize=12)\n",
        "    plt.ylabel('Speedup (Serial / Parallel)', fontsize=12)\n",
        "    plt.legend(title=\"Sparsity\")\n",
        "    plt.grid(True, which=\"both\", ls=\"-\", alpha=0.5)\n",
        "\n",
        "    plt.savefig(\"speedup_analysis.png\", dpi=300)\n",
        "    plt.show()\n",
        "\n",
        "# ==========================================\n",
        "# PLOT 3: Memory Footprint (Dense vs CSR)\n",
        "# ==========================================\n",
        "def plot_memory():\n",
        "    plt.figure(figsize=(10, 6))\n",
        "\n",
        "    # Plot Dense Memory\n",
        "    plt.plot(mem_df['Rows'], mem_df['Dense_MB'], 'r--', label='Dense Matrix (Theoretical)')\n",
        "\n",
        "    # Plot CSR Memory\n",
        "    plt.plot(mem_df['Rows'], mem_df['CSR_MB'], 'g-o', linewidth=2, label='CSR Matrix (Actual)')\n",
        "\n",
        "    # Use Log Scale because Dense is SO much bigger\n",
        "    plt.yscale('log')\n",
        "\n",
        "    plt.title('Memory Usage Comparison (Log Scale)', fontsize=14, fontweight='bold')\n",
        "    plt.xlabel('Matrix Dimension (N)', fontsize=12)\n",
        "    plt.ylabel('Memory (MB)', fontsize=12)\n",
        "    plt.legend()\n",
        "    plt.grid(True, which=\"both\", ls=\"-\", alpha=0.5)\n",
        "\n",
        "    plt.savefig(\"memory_analysis.png\", dpi=300)\n",
        "    plt.show()\n",
        "\n",
        "# --- RUN THE PLOTS ---\n",
        "print(\"Generating Plots...\")\n",
        "plot_execution_time(target_density=0.02) # Change 0.02 to 0.15 etc. if you want\n",
        "plot_speedup()\n",
        "plot_memory()"
      ],
